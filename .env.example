# Copy to .env for local development (npm run dev).
# On Vercel, set the same names under Project Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password admins type to log in at /admin
ADMIN_PASSWORD=

# Random string of 32+ characters used to sign the login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
