{
  "name": "avmlabs-gcc-b2c",
  "private": true,
  "type": "module",
  "description": "AVM Labs B2C website, admin panel and API",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node build.js && node scripts/copy-static.js && node scripts/sitemap.js",
    "check": "node build.js --check",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run lint && npm run format:check && npm test && npm run check",
    "start-work": "node start-work.js",
    "end-work": "node end-work.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
